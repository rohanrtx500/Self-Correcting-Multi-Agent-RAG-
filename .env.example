# Environment
ENVIRONMENT=development

# LLM Configuration
# Options: openai, groq, gemini, ollama
LLM_PROVIDER=openai

# OpenAI Config
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Groq Config
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini Config
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Ollama Config
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Tavily Search API (Optional for web search fallback)
TAVILY_API_KEY=your-tavily-api-key-here

# Vector Store Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=multi_agent_rag

# Retrieval & Hybrid Search
RETRIEVAL_TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
HYBRID_SEARCH_ENABLED=true
RERANKING_ENABLED=false
DOCUMENT_RELEVANCE_THRESHOLD=0.7
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30.0

# Security & Path Restrictions
ALLOWED_INGESTION_DIR=./sample_documents
UPLOAD_DIR=./uploaded_documents
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_QUESTION_LENGTH=2000
API_KEY_AUTH_ENABLED=false
API_KEY=your-secure-admin-api-key-here
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# System Settings
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
